<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- 引入 Spring Boot 默认日志属性 -->
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <!-- 控制台单行输出格式 -->
    <property name="CONSOLE_LOG_PATTERN"
              value="%d{HH:mm:ss.SSS} %highlight(%-5level) [%-28logger{28}] - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${CONSOLE_LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 应用包日志 -->
    <logger name="com.github.ylyan2015.springaidemo" level="DEBUG"/>

    <!-- Hibernate SQL：DEBUG 输出单行 SQL（format_sql=false） -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <!-- 抑制参数绑定日志，避免额外输出行 -->
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="WARN"/>
    <logger name="org.hibernate.orm.jdbc.bind" level="WARN"/>

    <!-- Spring 框架 -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.security" level="INFO"/>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
