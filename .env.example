# ==================== API Keys ====================
# 复制此文件为 .env 并填入真实的 API Key
# cp .env.example .env

# DeepSeek API Key（https://platform.deepseek.com/）
DEEPSEEK_API_KEY=sk-your-deepseek-key

# OpenAI API Key（https://platform.openai.com/）
OPENAI_API_KEY=sk-your-openai-key

# DashScope API Key（https://bailian.console.aliyun.com/）
# 图像生成（通义万相）必需；开启图片质量评估（image.quality.enabled）时亦复用此 Key
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ==================== Docker 部署数据库 ====================
# docker compose 部署必填：PostgreSQL 强密码（release 审查 Minor#14，不再使用硬编码 postgres/postgres）
POSTGRES_PASSWORD=change-me-to-a-strong-password
# 可选：自定义库名/用户名（默认 chatdb / postgres）
# POSTGRES_DB=chatdb
# POSTGRES_USER=postgres
